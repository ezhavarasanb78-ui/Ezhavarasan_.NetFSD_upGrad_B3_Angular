@{
}
@model IEnumerable<Student>

<h2>Student List with Course</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student Id</th>
            <th>Student Name</th>
            <th>Course Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentId</td>
                <td>@item.StudentName</td>
                <td>@item.course?.CourseName</td>
            </tr>
        }
    </tbody>
</table>