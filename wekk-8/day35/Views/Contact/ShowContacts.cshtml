    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<ContactInfo>


<h2>Contact List</h2>

<a href="/Contact/AddContact">Add New Contact</a>

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Designation</th>
            <th>Company</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactId</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.EmailId</td>
                <td>@item.MobileNo</td>
                <td>@item.Designation</td>
                <td>@item.CompanyName</td>
                <td>@item.DepartmentName</td>
                <td>
                    <a href="/contact/@item.ContactId">View</a> |
                    <a href="/contact/edit/@item.ContactId">Edit</a> |
                    <a href="/contact/delete/@item.ContactId"
                       onclick="return confirm('Are you sure?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>