@{
}

@model EF.Models.Movie

<h2>Delete Movie</h2>

<h3>Are you sure you want to delete this?</h3>

<div>
    <p><b>Title:</b> @Model.Title</p>
    <p><b>Genre:</b> @Model.Genre</p>
    <p><b>Release Date:</b> @Model.ReleaseDate.ToShortDateString()</p>
    <p><b>Price:</b> @Model.Price</p>
    <p><b>Rating:</b> @Model.Rating</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
</form>

<a href="/Movies/Index">Cancel</a>