}
<h3>Feedbackform</h3>
<form method="post" asp-action="Form" asp-controller="Form">
    <label>Name:</label>
    <input type="text" name="name"/>
    <br />
    <label>Comments:</label>
    <textarea name="comments"></textarea>
    <br />
    <label>Rating:</label>
    <input type="text" name="rating" min="1" max="5"/>
    <br />
    <button type="submit">submit</button>
</form>