@{
}
@model List<ContactApp.Models.ContactInfo>
<h2>Contact list</h2>
<a href="/Contact/AddContact" class="btn-primary">Add new Contact</a>
<a href="/Contact/GetContactbyId" class="btn-primary">Search contact</a>

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Company</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Designation</th>
    </tr>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.Id</td>
            <td>@i.FirstName @i.LastName</td>
            <td>@i.CompanyName</td>
            <td>@i.EmailId</td>
            <td>@i.MobileNo</td>
            <td>@i.Designation</td>
        </tr>
    }
</table>
